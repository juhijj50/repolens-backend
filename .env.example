# GitHub API token (Settings → Developer settings → Personal access tokens → classic)
# Needs `public_repo` scope. Bumps rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=ghp_your_token_here

# Groq API key (console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Neon Postgres connection string (with ?sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/repolens?sslmode=require

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://repolens.vercel.app

# Rate limits
MAX_ANALYSES_PER_IP_PER_DAY=10
MAX_CHAT_MESSAGES_PER_SESSION=20

# Repo size limits
MAX_REPO_FILES=500
MAX_REPO_SIZE_MB=5
MAX_FILE_SIZE_KB=100
